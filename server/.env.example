# Copy to server/.env for local development.
# MongoDB connection string. Use your own Atlas cluster or a local mongod.
# Tests do NOT need this: they spin up mongodb-memory-server instead.
MONGODB_URI="mongodb://127.0.0.1:27017/restaurant_reservations"

# Port the Express API listens on (client dev server proxies /api here).
PORT=4000

# Password for the seeded staff account (username "staff").
# Leave unset and `npm run seed` generates a random password, printing it once.
# Never commit a real value here.
# SEED_STAFF_PASSWORD=
